# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — used only by n8n (set in n8n credentials, NOT here)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# On production: NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── n8n Automation ──────────────────────────────────────────────────────────
# Lesson Processor webhook (called by ImportTranscriptForm)
N8N_WEBHOOK_URL=https://your-n8n.app.n8n.cloud/webhook/process-lesson
# Drive Monitor webhook (called by "Check for new recaps" button in dashboard)
N8N_DRIVE_WEBHOOK_URL=https://your-n8n.app.n8n.cloud/webhook/check-drive

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Get your key at: https://resend.com → API Keys
RESEND_API_KEY=re_...

# ─── Teacher account ─────────────────────────────────────────────────────────
# The teacher's email — used as a reference, no code reads this directly
TEACHER_EMAIL=teacher@example.com
